@namespace LibraryManagementSystem.Web.Shared
@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (!AuthService.IsAuthenticated)
{
    <div class="auth-loading">
        <div class="spinner"></div>
        <span>@(hasCheckedSession ? "Redirecting to login..." : "Checking session...")</span>
    </div>
}
else
{
    <div class="app-layout">
        <div class="sidebar">
            <NavMenu />
            <div class="sidebar-footer">
                <div class="avatar">@(AuthService.CurrentUser?.FullName.FirstOrDefault().ToString().ToUpper() ?? "A")</div>
                <div class="user-info">
                    <div class="user-name">Welcome, @AuthService.CurrentUser?.FullName</div>
                    <div class="user-role">@AuthService.CurrentUser?.Role</div>
                </div>
                <button class="logout-btn" title="Logout" @onclick="Logout">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                </button>
            </div>
        </div>

        <div class="main">
            <div class="header">
                <span class="header-title">Library Management System</span>
                <div class="header-actions">
                    <div class="search-wrap">
                        <span class="search-icon">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="11" cy="11" r="8"/>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                            </svg>
                        </span>
                        <input type="text"
                               placeholder="Search books, authors, or ISBN..."
                               @bind="searchQuery"
                               @oninput="OnSearch" />
                    </div>
                    <button class="header-icon-btn" title="Notifications">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="body-content">
                @Body
            </div>
        </div>
    </div>
}

@code {
    private string searchQuery = string.Empty;
    private bool hasCheckedSession = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (!AuthService.IsAuthenticated)
        {
            try
            {
                var savedUser = await JS.InvokeAsync<string?>("sessionStorage.getItem", "vitb-lib-user");
                if (!string.IsNullOrWhiteSpace(savedUser))
                {
                    var user = System.Text.Json.JsonSerializer.Deserialize<LoggedInUser>(savedUser);
                    AuthService.RestoreUser(user);
                }
            }
            catch
            {
                AuthService.RestoreUser(null);
            }
        }

        hasCheckedSession = true;

        if (!AuthService.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        StateHasChanged();
    }

    private void OnSearch(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
    }

    private async Task Logout()
    {
        AuthService.Logout();
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "vitb-lib-user");
        Nav.NavigateTo("/login");
    }
}
