@page "/settings"
@inject AuthService AuthService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-header">
    <div class="page-header-left">
        <h1>Settings</h1>
        <p>Manage your library system preferences.</p>
    </div>
</div>

<div class="settings-grid">

    <!-- Profile Section -->
    <div class="settings-card">
        <div class="settings-card-header">
            <div class="settings-card-icon blue">
                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div>
                <div class="settings-card-title">Account Profile</div>
                <div class="settings-card-sub">Your login and display details</div>
            </div>
        </div>
        <div class="settings-rows">
            <div class="settings-row">
                <span class="settings-row-label">Full Name</span>
                <span class="settings-row-value">@AuthService.CurrentUser?.FullName</span>
            </div>
            <div class="settings-row">
                <span class="settings-row-label">Username</span>
                <span class="settings-row-value">@AuthService.CurrentUser?.Username</span>
            </div>
            <div class="settings-row">
                <span class="settings-row-label">Role</span>
                <span class="settings-row-value">
                    <span class="badge badge-available">@AuthService.CurrentUser?.Role</span>
                </span>
            </div>
        </div>
    </div>

    <!-- System Section -->
    <div class="settings-card">
        <div class="settings-card-header">
            <div class="settings-card-icon purple">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            </div>
            <div>
                <div class="settings-card-title">System Information</div>
                <div class="settings-card-sub">About this installation</div>
            </div>
        </div>
        <div class="settings-rows">
            <div class="settings-row">
                <span class="settings-row-label">System Name</span>
                <span class="settings-row-value">VITB Library Management System</span>
            </div>
            <div class="settings-row">
                <span class="settings-row-label">Version</span>
                <span class="settings-row-value">1.0.0</span>
            </div>
            <div class="settings-row">
                <span class="settings-row-label">Database</span>
                <span class="settings-row-value">PostgreSQL (Neon)</span>
            </div>
            <div class="settings-row">
                <span class="settings-row-label">Framework</span>
                <span class="settings-row-value">Blazor Server — .NET 10</span>
            </div>
        </div>
    </div>

    <!-- Quick Links Section -->
    <div class="settings-card">
        <div class="settings-card-header">
            <div class="settings-card-icon orange">
                <svg viewBox="0 0 24 24"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
            </div>
            <div>
                <div class="settings-card-title">Quick Links</div>
                <div class="settings-card-sub">Jump to key sections</div>
            </div>
        </div>
        <div class="settings-quick-links">
            <NavLink href="/collection" class="settings-link">
                <svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 19.5A2.5 2.5 0 0 0 6.5 22H20V2H6.5A2.5 2.5 0 0 0 4 4.5v15z"/></svg>
                View Collection
            </NavLink>
            <NavLink href="/members" class="settings-link">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                Manage Members
            </NavLink>
            <NavLink href="/loans" class="settings-link">
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                Active Loans
            </NavLink>
            <NavLink href="/reports" class="settings-link">
                <svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                Reports
            </NavLink>
        </div>
    </div>

    <!-- Session Section -->
    <div class="settings-card">
        <div class="settings-card-header">
            <div class="settings-card-icon red">
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </div>
            <div>
                <div class="settings-card-title">Session</div>
                <div class="settings-card-sub">Manage your current session</div>
            </div>
        </div>
        <div class="settings-rows">
            <div class="settings-row">
                <span class="settings-row-label">Status</span>
                <span class="settings-row-value"><span class="badge badge-available">Active</span></span>
            </div>
        </div>
        <div style="padding: 0 18px 18px;">
            <button class="btn-danger" style="width:100%;justify-content:center;display:flex;gap:6px;align-items:center;" @onclick="Logout">
                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                Sign Out
            </button>
        </div>
    </div>

</div>

@code {
    private async Task Logout()
    {
        AuthService.Logout();
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "vitb-lib-user");
        Nav.NavigateTo("/login");
    }
}
